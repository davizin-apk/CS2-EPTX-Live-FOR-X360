# Porta do servidor
EPTX_PORT=8360

# Bind. 0.0.0.0 para o console enxergar na LAN.
EPTX_HOST=0.0.0.0

# Onde ficam os jogos (pacotes GOD/LIVE/CON, ISOs, pastas com default.xex)
# Windows: use barra normal ou dupla invertida
EPTX_LIBRARY=D:/Xbox360/Games

# Banco SQLite
EPTX_DB=./data/eptx.db

# Segredo mestre do servidor (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
EPTX_SECRET=troque-isto-por-32-bytes-hex

# Janela de tolerancia do timestamp assinado, em segundos.
# O relogio do 360 costuma estar errado; 900 = 15min.
EPTX_CLOCK_SKEW=900
